# Example environment variables for production deployment
# APP_IMAGE is required in production and must include a tag, e.g. ghcr.io/vasenin26/docmodule:v2025.10.1
APP_IMAGE=ghcr.io/vasenin26/docmodule:vYYYY.WW.N

# External Traefik Docker network (must exist on the host; Traefik container must be attached to it)
TRAEFIK_NETWORK=web

# Traefik entrypoints for HTTPS router (default matches common setups with TLS on websecure)
# TRAEFIK_ENTRYPOINTS=websecure

# Optional: override base URL for deploy.sh public smoke check (default https://docsmodule.ru)
# HEALTH_PUBLIC_URL=https://docsmodule.ru

# GHCR pull on server (private images)
# GHCR_USERNAME=github-username
# GHCR_TOKEN=ghp_xxx
